# ============================================================
# 9Router Cloud Gateway - Environment Variables
# Configure these in your Vercel or Netlify Project Settings
# Only configure the providers you plan to use!
# ============================================================

# (Optional) Gateway Secret: Protect your proxy so unauthorized people cannot use your Vercel endpoint
# Clients must send: Authorization: Bearer <ROUTER_API_KEY>
ROUTER_API_KEY=your_secret_gateway_key_here

# ------------------------------------------------------------
# AI Model Providers
# ------------------------------------------------------------

# Anthropic Claude (Claude 3.7 Sonnet, Claude 3.5 Sonnet, Claude 3.5 Haiku)
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI (GPT-4o, GPT-4o-mini, o1, o3-mini)
OPENAI_API_KEY=sk-proj-...

# Google Gemini (Gemini 2.0 Flash, Gemini 1.5 Pro - Free tier available!)
GEMINI_API_KEY=AIzaSy...

# DeepSeek (DeepSeek V3, DeepSeek R1)
DEEPSEEK_API_KEY=sk-...

# Groq (Ultra-fast LPU inference for LLaMA 3.3 70B & DeepSeek R1 Distill)
GROQ_API_KEY=gsk_...

# OpenRouter (Unified fallback covering 200+ models)
OPENROUTER_API_KEY=sk-or-v1-...

# Mistral AI (Codestral, Mistral Large)
MISTRAL_API_KEY=...

# Together AI (Qwen 2.5 Coder 32B, LLaMA 3.3)
TOGETHER_API_KEY=...

# Custom / Ollama Local Base URL (Optional)
CUSTOM_BASE_URL=http://localhost:11434/v1
CUSTOM_API_KEY=
