# ============================================================
# 9Router Cloud Gateway - Environment Variables
# Configure these in your Vercel or Netlify Project Settings
# Only configure the providers you plan to use!
# ============================================================

# (Optional) Gateway Secret: Protect your proxy so unauthorized people cannot use your Vercel endpoint
# Clients must send: Authorization: Bearer <ROUTER_API_KEY>
ROUTER_API_KEY=Kirana8292@#2

# ------------------------------------------------------------
# AI Model Providers
# ------------------------------------------------------------

# Anthropic Claude (Claude 3.7 Sonnet, Claude 3.5 Sonnet, Claude 3.5 Haiku)
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI (GPT-4o, GPT-4o-mini, o1, o3-mini)
OPENAI_API_KEY=sk-proj-...

# Google Gemini (Gemini 2.0 Flash, Gemini 1.5 Pro - Free tier available!)
GEMINI_API_KEY=AIzaSy...

# DeepSeek (DeepSeek V3, DeepSeek R1)
DEEPSEEK_API_KEY=sk-...

# Groq (Ultra-fast LPU inference for LLaMA 3.3 70B & DeepSeek R1 Distill)
GROQ_API_KEY=gsk_...

# OpenRouter (Unified fallback covering 200+ models)
OPENROUTER_API_KEY=sk-or-v1-...

# Mistral AI (Codestral, Mistral Large)
MISTRAL_API_KEY=...

# Together AI (Qwen 2.5 Coder 32B, LLaMA 3.3)
TOGETHER_API_KEY=...

# Cloudflare Workers AI (Free 10,000 neurons/day for LLaMA 3.3, Qwen 2.5 Coder)
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_ACCOUNT_ID=...

# Cerebras AI (1,800 tok/s ultra fast LPU)
CEREBRAS_API_KEY=csk-...

# SiliconFlow (SiliconCloud for DeepSeek V3/R1 & Qwen)
SILICONFLOW_API_KEY=sk-...

# Perplexity AI (Sonar models with live citations)
PERPLEXITY_API_KEY=pplx-...

# Custom / Ollama Local Base URL (Optional)
CUSTOM_BASE_URL=http://localhost:11434/v1
CUSTOM_API_KEY=

# ------------------------------------------------------------
# Persistent Database Backend (MongoDB Atlas OR Supabase PostgreSQL)
# Retains Security Gate Key, Client API Tokens, & Request Logs permanently
# ------------------------------------------------------------

# Opsi 1: MongoDB Atlas (Free M0 Cluster / Self-hosted)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/9router?retryWrites=true&w=majority
MONGODB_DB=9router

# Opsi 2: Supabase (PostgreSQL Cloud Free Tier)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...
SUPABASE_TABLE=nine_router_state

# Opsi 3: (Opsional) Upstash Redis / Vercel KV REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

